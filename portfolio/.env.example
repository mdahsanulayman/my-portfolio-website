# Copy this file to .env.local and fill in ONE of the two options below.
# Restart `npm run dev` after changing it. On Vercel: Project > Settings > Environment Variables.

# Your public website URL (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Option A: Formspree (https://formspree.io) - paste only the form ID, e.g. "xyzabcde"
NEXT_PUBLIC_FORMSPREE_ID=

# Option B: EmailJS (https://www.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
